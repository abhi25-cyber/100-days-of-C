
#include <stdio.h>

int main() {
    int a, b;
    char op;

    printf("Enter two numbers and operator: ");
    scanf("%d %d %c", &a, &b, &op);

    switch (op) {
        case '+':
            printf("%d\n", a + b);
            break;

        case '-':
            printf("%d\n", a - b);
            break;

        case '*':
            printf("%d\n", a * b);
            break;

        case '/':
            if (b != 0)
                printf("%d\n", a / b);
            else
                printf("Division by zero not allowed");
            break;

        case '%':
            if (b != 0)
                printf("%d\n", a % b);
            else
                printf("Modulo by zero not allowed");
            break;

        default:
            printf("Invalid Operator");
    }

    return 0;
}
