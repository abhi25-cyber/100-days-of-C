
#include <stdio.h>

int main() {
    int n, original, rem, fact, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    while (n > 0) {
        rem = n % 10;
        fact = 1;

        for (int i = 1; i <= rem; i++) {
            fact = fact * i;
        }

        sum = sum + fact;
        n = n / 10;
    }

    if (sum == original) {
        printf("Strong number\n");
    }
    else {
        printf("Not strong number\n");
    }

    return 0;
}
