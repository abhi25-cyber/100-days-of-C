
#include <stdio.h>

int main() {
    int n, m, i;

    printf("Enter size of first array: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter first array elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("Enter size of second array: ");
    scanf("%d", &m);

    int b[m];
    int c[n + m];

    printf("Enter second array elements: ");
    for (i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }

    // Copy first array
    for (i = 0; i < n; i++) {
        c[i] = a[i];
    }

    // Copy second array
    for (i = 0; i < m; i++) {
        c[n + i] = b[i];
    }

    // Print merged array
    for (i = 0; i < n + m; i++) {
        printf("%d ", c[i]);
    }

    return 0;
}
